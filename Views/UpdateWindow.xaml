<Window x:Class="BODA.CMS.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 버전"
        Height="520" Width="620"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <!-- 인앱 업데이트 창 (2단계): 릴리스 정보 + 노트 + [지금 설치] 다운로드·검증·UAC 설치 위임 / [다운로드 페이지] / [나중에] -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionLine" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="[지금 설치]는 모니터 앱 설치 파일(MSI)을 내려받아 무결성을 검증한 뒤 관리자 권한으로 설치하고 앱을 다시 시작합니다. 감시 서버(Collector)는 이 업데이트에 포함되지 않습니다 — 릴리스 페이지의 collector MSI로 별도 업그레이드하세요." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource InsetPanel}" Margin="0,12,0,0" Padding="4">
            <TextBox x:Name="Notes" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"
                         Background="{StaticResource InsetBrush}" Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" Visibility="Collapsed" />
            <TextBlock x:Name="Status" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="LaterButton" Content="나중에" Padding="14,6" Margin="0,0,8,0" Click="OnLaterClick" />
            <Button x:Name="PageButton" Content="다운로드 페이지" Padding="14,6" Margin="0,0,8,0" Click="OnPageClick"
                    ToolTip="브라우저에서 릴리스 페이지를 엽니다 — 직접 내려받아 설치할 때" />
            <Button x:Name="InstallButton" Content="지금 설치" Padding="14,6" FontWeight="SemiBold" Click="OnInstallClick" />
        </StackPanel>
    </Grid>
</Window>
